<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <!-- Maven project description. Dependencies below supply libraries used by the Java source. -->
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.lankaswisstek</groupId>
  <artifactId>sales-order-backend</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <!-- Spring Boot parent provides compatible dependency versions and plugin defaults. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.6</version>
    <relativePath />
  </parent>
  <!-- Compile against Java 21 language/API features. -->
  <properties>
    <java.version>21</java.version>
  </properties>
  <dependencies>
    <!-- REST controllers, JSON conversion, and the embedded Tomcat HTTP server. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- Repository implementations and Hibernate object-to-database mapping. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    
    <!-- PostgreSQL database driver; runtime scope means it is needed when running the application. -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Run versioned schema migrations before Hibernate opens the existing tables. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <!-- Bean validation for annotations such as @NotBlank and controller @Valid. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- Testing libraries; test scope keeps them out of the normal application classpath. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <!-- Enables Spring Boot Maven tasks such as spring-boot:run and executable packaging. -->
  <build>
    <plugins>
      <!-- Load Mockito's test agent at JVM startup, avoiding runtime self-attachment. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-javaagent:"${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar"</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
